# --- Spotify "Now Playing" pill (optional) ---
# Leave these blank to hide the pill entirely.
# See README and the chat walkthrough for how to obtain a refresh token.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# --- NetEase Cloud Music 网易云音乐 top tracks (optional) ---
# NetEase has no official API/OAuth — this uses your account cookie.
# Leave blank to hide the 网易云 tab.
#   NETEASE_UID    = the number in your profile URL
#                    (music.163.com/#/user/home?id=XXXXXXXX)
#   NETEASE_COOKIE = the value of your MUSIC_U cookie (token only, no "MUSIC_U=")
# Your listen records must be public: NetEase → 设置 → 隐私 →
#   "允许其他人查看我的播放记录". See README for how to grab the cookie.

NETEASE_UID=
NETEASE_COOKIE=
